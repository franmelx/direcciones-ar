{
  "name": "direcciones-ar",
  "version": "0.4.0",
  "description": "Búsqueda y normalización de direcciones argentinas con precisión explícita y proveedores configurables",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.js",
    "test": "npm run build && tsc -p tsconfig.tools.json && node --test dist-tools/test/*.test.js",
    "test:amba": "tsc -p tsconfig.tools.json && node dist-tools/scripts/test-amba.js",
    "test:amba:inventory": "tsc -p tsconfig.tools.json && node dist-tools/scripts/test-amba-inventory.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.demo.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/franmelx/direcciones-ar.git"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@turf/distance": "7.3.5"
  }
}
